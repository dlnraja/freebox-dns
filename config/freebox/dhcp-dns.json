{
  "title": "Freebox OS — paramètres DNS / DHCP recommandés (local-only)",
  "privacy": "No street address, box UID, or remote fbxos domain.",
  "lexicon_doc": "docs/dns-lexicon.md",
  "compatible": [
    "Freebox Delta",
    "Freebox Ultra",
    "Freebox Server v9 (r1) / API 16+",
    "VM Freebox (Debian/Ubuntu guest)"
  ],
  "local_personalities": {
    "dns_libre": {
      "bit": "uncensored",
      "display_name": "Libre / Uncensored",
      "inspired_by_pins": ["FREEBOX_DNS_1", "FREEBOX_DNS_2", "FREEBOX_DNS_3"],
      "tagline": "Full answers — Quad9 Unsecured + Mullvad + AdGuard NF (+ DoT catalog)"
    },
    "dns_secure": {
      "bit": "threat-local",
      "display_name": "Secure / Threat-local",
      "inspired_by_pins": ["FREEBOX_DNS_4"],
      "tagline": "Local DNS firewall — NextDNS denylist toolkit, no cloud/parental"
    },
    "site": {
      "bit": "lan-gateway",
      "inspired_by_pins": ["FREEBOX_DNS_5"]
    }
  },
  "host": {
    "HOST_IP_placeholder": "192.168.1.71",
    "note": "IP LAN fixe de la VM Freebox freebox-dns (PAS l'IP du PC Windows). Réserver le bail dans Freebox OS."
  },
  "lab_ports": {
    "dns_libre": 5356,
    "dns_secure": 5354,
    "doh_libre": 8453,
    "doh_secure": 8444,
    "blocky_ui": 3080,
    "note": "Sur Windows, 5353 est souvent pris (mDNS). En lab Freebox DHCP ne pousse que le port 53 — utiliser overlay prod ou forwarder."
  },
  "prod_recommended": {
    "dhcp_dns_primary": "9.9.9.10",
    "dhcp_dns_secondary": "${HOST_IP}",
    "comment": "DNS1 = SOS Quad9 9.9.9.10 No Threat Blocking, no ECS (UDP/53 OK on FR ISP) ; DNS2 = dns-libre on VM :53. UncensoredDNS/DG = DoT only. See docs/quad9.md."
  },
  "dual_personality_ideal": {
    "option_a_two_ips": {
      "dns1": "${HOST_IP_LIBRE}",
      "dns2": "${HOST_IP_SECURE}",
      "note": "Deux IP LAN (macvlan ou 2 VM) toutes deux sur UDP/TCP 53 — esprit NextDNS multi-config, en local."
    },
    "option_b_single_ip": {
      "dns1": "${HOST_IP}",
      "dns2": "9.9.9.10",
      "secure_via": "DoH https://${HOST_IP}:8444/dns-query or clients pointed to :5354"
    }
  },
  "doh_clients": {
    "libre": "https://${HOST_IP}:8453/dns-query",
    "secure": "https://${HOST_IP}:8444/dns-query",
    "profiles": "config/clients/generated/",
    "doc": "docs/encrypted-dns.md"
  },
  "dot_clients": {
    "libre": "tls://${HOST_IP}:8853",
    "libre_prod": "tls://${HOST_IP}:853",
    "secure": "tls://${HOST_IP}:8854"
  },
  "doq_clients": {
    "libre": "quic://${HOST_IP}:8853",
    "libre_prod": "quic://${HOST_IP}:853"
  },
  "freebox_os_path": [
    "Paramètres de la Freebox",
    "Mode avancé → DHCP",
    "Serveurs DNS : personnalisés"
  ],
  "vm_guest": {
    "suggested_os": "Debian 12 or Ubuntu 24.04",
    "packages": ["docker.io", "docker-compose-v2", "curl", "ca-certificates"],
    "compose_files": ["docker-compose.yml", "docker-compose.prod.yml"],
    "images_pulled_by_compose": [
      "mvance/unbound:latest",
      "adguard/dnsproxy:latest",
      "ghcr.io/0xerr0r/blocky:latest"
    ]
  },
  "fallback_pins_order": [
    "9.9.9.10",
    "149.112.112.10",
    "194.242.2.2",
    "94.140.14.140",
    "94.140.14.141",
    "193.110.81.254",
