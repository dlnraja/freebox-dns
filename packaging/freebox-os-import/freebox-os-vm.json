{
  "name": "freebox-dns",
  "description": "All-in-one dual DNS (dns-libre + dns-secure) for Freebox OS VM import",
  "freebox_os": {
    "compatible": ["Freebox Delta", "Freebox Ultra", "Freebox Server v9+"],
    "ui_path": ["Freebox OS", "VM", "Ajouter une VM", "Sélectionner une image de disque existante"],
    "disk_format": "qcow2",
    "also_accepted": ["raw"]
  },
  "vm": {
    "name": "freebox-dns",
    "vcpus": 2,
    "memory_mb": 2048,
    "disk_type": "qcow2",
    "disk_filename": "freebox-dns.qcow2",
    "suggested_disk_path_on_box": "/VMs/freebox-dns.qcow2",
    "os": "debian",
    "enable_screen": true,
    "enable_cloudinit": true,
    "cloudinit_hostname": "freebox-dns",
    "cloudinit_userdata_file": "cloudinit-userdata.yaml",
    "network": "LAN bridge"
  },
  "guest": {
    "os_image_base": "Debian 12 cloud (arm64 / aarch64 — Freebox VM)",
    "arch": "aarch64",
    "note": "Freebox OS VMs are ARM64. amd64 images only PXE-loop.",
    "disk_gb": 16,
    "services": ["unbound", "dns-libre", "dns-malware", "dns-antipub", "dns-secure"],
    "ports": {
      "dns_uncensored": 53,
      "dns_malware": 5357,
      "dns_antipub": 5358,
      "dns_secure": 5354,
      "doh_uncensored": 8453,
      "doh_malware": 8445,
      "doh_antipub": 8446,
      "doh_secure": 8444,
      "blocky_ui": 3080
    },
    "modes_doc": "docs/modes.md"
  },
  "dhcp_after_import": {
    "dns_primary": "9.9.9.10",
    "dns_secondary": "IP_LAN_DE_LA_VM",
    "note": "DNS1=SOS Quad9 Unsecured, DNS2=VM only after health OK"
  },
  "package_files": [
    "freebox-dns.qcow2",
    "freebox-dns-cidata.iso",
    "freebox-os-vm.json",
    "cloudinit-userdata.yaml",
    "IMPORT-FREEBOX-OS.md",
    "SHA256SUMS"
  ],
  "cdrom": {
    "file": "freebox-dns-cidata.iso",
    "role": "NoCloud cloud-init seed — mount as Freebox virtual CD-ROM on first boot",
    "required_on_first_boot": true
  },
  "api_create_hint": {
    "disk_type": "qcow2",
    "disk_path": "<chemin_disque_freebox>/VMs/freebox-dns.qcow2",
    "cd_path": "<chemin_disque_freebox>/VMs/freebox-dns-cidata.iso",
    "vcpus": "2",
    "memory": "2048",
    "name": "freebox-dns",
    "os": "debian",
    "enable_cloudinit": "true",
    "cloudinit_hostname": "freebox-dns",
    "enable_screen": "true"
  }
}

