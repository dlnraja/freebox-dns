# Copy to .env and adjust. Never commit .env (may contain LAN IPs you prefer private).

# --- Host / LAN (local-only bind — never leave empty) ---
HOST_IP=192.168.1.50
# Optional LAN IPv6 (docker compose -f docker-compose.yml -f docker-compose.ipv6.yml up -d)
# HOST_IP6=2a01:e0a:xxxx:xxxx::15
HOST_IP6=

# --- Smart modes (lab ports — Freebox DHCP :53 via docker-compose.prod.yml) ---
# uncensored  → dns-libre
DNS_LIBRE_PORT=5356
DOH_LIBRE_PORT=8453
DOT_LIBRE_PORT=8853
DOQ_LIBRE_PORT=8853
# malware-free → dns-malware
DNS_MALWARE_PORT=5357
DOH_MALWARE_PORT=8445
DOT_MALWARE_PORT=8855
# antipub intelligent → dns-antipub
DNS_ANTIPUB_PORT=5358
DOH_ANTIPUB_PORT=8446
DOT_ANTIPUB_PORT=8856
# secure full (antipub + malware) → dns-secure
DNS_SECURE_PORT=5354
DOH_SECURE_PORT=8444
DOT_SECURE_PORT=8854
BLOCKY_HTTP_PORT=3080
DOH_CN=freebox-dns.local

# --- Pinned Freebox / LAN DNS fallbacks (captured once; do not remote-poll) ---
FREEBOX_DNS_1=91.239.100.100
FREEBOX_DNS_2=185.95.218.42
FREEBOX_DNS_3=9.9.9.10
FREEBOX_DNS_4=45.90.28.0
FREEBOX_DNS_5=192.168.1.254

# --- Max uncensoring DoT (see config/upstreams/uncensoring-catalog.json) ---
UPSTREAM_DOT_1=tls://dns.mullvad.net
UPSTREAM_DOT_2=tls://open.dns0.eu
UPSTREAM_DOT_3=tls://dns.digitale-gesellschaft.ch
UPSTREAM_DOT_4=tls://anycast.uncensoreddns.org
UPSTREAM_DOT_5=tls://unicast.uncensoreddns.org
UPSTREAM_DOT_6=tls://dns10.quad9.net
UPSTREAM_DOT_7=tls://dot1.applied-privacy.net
UPSTREAM_DOT_8=tls://dot.libredns.gr
UPSTREAM_DOT_9=tls://eu1.dns.lavate.ch
UPSTREAM_DOT_10=tls://open.public-rdns.com
UPSTREAM_DOT_11=tls://dns.radeksprta.eu
UPSTREAM_DOT_12=tls://uncensored.freedns.controld.com
UPSTREAM_DOT_13=tls://dns-unfiltered.adguard.com

# Anti-lie local layer (OONI-inspired) — docs/anti-lie-dns.md + docs/osint-toolkit.md
# python3 scripts/ooni-like-anti-lie.py && python3 scripts/web-connectivity-lite.py
# Optional OSINT UI: docker compose --profile osint up -d web-check → HOST_IP:WEBCHECK_PORT
WEBCHECK_PORT=3090

